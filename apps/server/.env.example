# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# Frontend URL for CORS (use your Render frontend URL in production)
# Example: https://x402-pay-web.onrender.com
FRONTEND_URL=http://localhost:3000

# ============================================
# x402 CONFIGURATION
# ============================================
# For production mainnet, use a facilitator URL from https://www.x402.org/ecosystem?category=facilitators
# For Base Sepolia testnet, use: https://x402.org/facilitator
X402_FACILITATOR_URL=https://x402.org/facilitator

# Company wallet address to receive USDC payments on Base Sepolia
# This is where all USDC payments will be sent
# ⚠️ IMPORTANT: Set this to your actual wallet address in production!
COMPANY_WALLET_ADDRESS=0xfc23834846a42eD1edC70f253CF1919c93EAbA16

# x402 Network (base-sepolia for testnet, base for mainnet)
X402_NETWORK=base-sepolia

# ============================================
# DATABASE
# ============================================
# Path to SQLite database file
# On Render, use a persistent disk: /var/data/crypto-inr.db
DATABASE_PATH=./data/crypto-inr.db

# ============================================
# SECURITY
# ============================================
# Session secret for cookie signing (auto-generated on Render)
SESSION_SECRET=your-secret-key-here
